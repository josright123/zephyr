# ETH_ENC28J60 Ethernet driver configuration options

# Copyright (c) 2015 Intel Corporation
# SPDX-License-Identifier: Apache-2.0

menuconfig ETH_DM9051
	bool "DM9051 Ethernet Controller"
	default y
#	depends on DT_HAS_DAVICOM_DM9051_ENABLED
	select SPI
	help
	  DM9051 Stand-Alone Ethernet Controller
	  with SPI Interface

if ETH_DM9051

config ETH_DM9051_DEBUG_PRINTS
	bool "Enable DM9051 debug printk output"
	default n
	help
	  Enable verbose printk-based debug output in the DM9051 driver.
	  Disable to reduce console noise

config ETH_DM9051_RX_THREAD_PRIO
	int "Priority for internal incoming packet handler"
	depends on ETH_DM9051
	default 2
	help
	  Priority level for internal thread which is ran for incoming
	  packet processing.

config ETH_DM9051_TX_CHECKSUM_OFFLOAD
	bool "Enable DM9051 checksum offload"
	default n
	help
	  Enable checksum offload.

config ETH_DM9051_MULTICAST_FILTER
	bool "Enable DM9051 multicast pass all"
	default n
	help
	  Enable multicast pass all.

config ETH_DM9051_ID_VERIFY_RETRY_COUNT
	int "Chip ID verify retry count"
	default 30
	help
	  Number of times the driver will retry reading and verifying
	  the DM9051 chip ID during initialization. If verification still
	  fails after all retries, the driver init returns an error instead
	  of blocking boot.

config ETH_DM9051_ID_VERIFY_RETRY_DELAY_MS
	int "Delay (ms) between chip ID verify retries"
	default 100
	help
	  Delay in milliseconds between consecutive DM9051 chip ID verify
	  retries during initialization.

#config ETH_DM9051_CLKRDY_INIT_WAIT_MS
#	int "Time to wait for the CLKRDY bit on driver init"
#	depends on ETH_DM9051
#	default 2
#	help
#	  Timeout in milliseconds. Maximum time the initialisation
#	  of the driver will wait for the OST to expire, indicated
#	  by the CLKRDY bit set. If timeout driver init will fail
#	  with -ETIMEDOUT.

#config ETH_DM9051_TIMEOUT
#	int "IP buffer timeout"
#	depends on ETH_DM9051
#	default 100
#	help
#	  Given timeout in milliseconds. Maximum amount of time
#	  that the driver will wait from the IP stack to get
#	  a memory buffer before the Ethernet frame is dropped.

endif # ETH_DM9051
