#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>

/* SPI1: MISO=12, CS=13, SCK=14, MOSI=15
 * DM9051 INT=20 (active low)
 */

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&pinctrl {
    spi1_dm9051_default: spi1_dm9051_default {
        group1 {
            pinmux = <SPI1_RX_P12>, <SPI1_SCK_P14>, <SPI1_TX_P15>;
        };
    };
};

&spi1 {
    pinctrl-0 = <&spi1_dm9051_default>;
    pinctrl-names = "default";
    cs-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
    status = "okay";

    dm9051: ethernet@0 {
        compatible = "davicom,dm9051";
        reg = <0>;
        spi-max-frequency = <2000000>;
        int-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
        status = "okay";
    };
};